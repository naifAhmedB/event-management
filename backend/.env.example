SECRET_KEY=django-insecure-change-this-in-production-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://eventuser:eventpass@localhost:5432/eventdb

# Mock services (set to False and add real credentials to enable live sending)
MOCK_OTP=True
MOCK_WHATSAPP=True
MOCK_PAYMENT=True

# Ultramsg WhatsApp API — https://app.ultramsg.com
# Create an instance, connect your phone, then copy the Instance ID and Token
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=your_token_here

# Frontend URL (for QR codes and invite links)
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
